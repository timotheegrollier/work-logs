# /etc/worklogs-relais/env — lu par worklogs-relais.service (root:worklogs-relais, 0640).
# Le dossier des procédures, monté seul (voir fstab.exemple) :
WORKLOGS_SHARED_ROOT=/mnt/tse-procedures
# Le nom affiché de ce dossier (le point de montage s'appelle autrement) :
WORKLOGS_RELAY_LABEL="00. PROCEDURE"
# Origines supplémentaires acceptées en plus des deux PWA WorkLogs (Worker et GitHub Pages) :
# WORKLOGS_RELAY_ORIGINS=https://mon-client.example
# Nom affiché dans les verrous (LibreOffice, autres WorkLogs) pour ce qui est fait depuis le téléphone :
WORKLOGS_RELAY_NAME="Timothée Grollier (mobile)"
WORKLOGS_RELAY_DATA=/var/lib/worklogs-relais
HOST=127.0.0.1
PORT=8420
