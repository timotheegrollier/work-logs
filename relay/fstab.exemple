# Ligne à ajouter à /etc/fstab : seulement le dossier des procédures (\040 = espace), monté à la
# demande, au nom du relais. Rien d'autre du partage D n'est visible depuis la VM.
//172.16.1.20/D/Global/MURGAT\040INGENIERIE/13.\040SI/00.\040PROCEDURE  /mnt/tse-procedures  cifs  credentials=/etc/worklogs-relais/smb.cred,uid=worklogs-relais,gid=worklogs-relais,file_mode=0660,dir_mode=0770,vers=3.0,iocharset=utf8,_netdev,nofail,x-systemd.automount  0  0
